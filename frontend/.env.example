# Origem dos dados do FleetLab: "mock" (padrão, dados fictícios locais) ou "http" (dados reais da rodada v2).
VITE_DATA_SOURCE=mock
# Usado apenas quando VITE_DATA_SOURCE=http. "/api" passa pelo proxy do Vite até `tcc-frota fleetlab-serve`
# (127.0.0.1:8000). Não coloque credenciais aqui.
VITE_API_BASE_URL=/api
