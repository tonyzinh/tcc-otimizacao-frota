# Somente para auditoria LOCAL de arquivos reais, após autorização formal.
TCC_REAL_DATA_AUTHORIZED=
# Exige autorização separada para qualquer ambiente externo. O projeto não faz upload automático.
TCC_EXTERNAL_DATA_AUTHORIZED=

# Conexões SOMENTE LEITURA (src/tcc_frota/leitura). Use contas de leitura; o .env real fica fora do Git.
DW_DATABASE=
ODS_DATABASE=
STG_DATABASE=
# Vale para DW, ODS e STG
SERVER=
USER=
PASSWORD=
# Elasticsearch (URL completa, ex.: https://host:9243)
ENDPOINT=
ES_USER=
ES_PASSWORD=
# Opcionais: SQL_DRIVER, SQL_TRUST_SERVER_CERTIFICATE=true, ES_VERIFY_TLS=false
